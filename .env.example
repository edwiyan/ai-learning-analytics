DATABASE_URL=postgresql://ailas_user:ailas_pass@localhost:5432/ailas_db
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional fallback LLM when OpenAI is down. Off unless GEMINI_ENABLED=true; use a paid
# Gemini account so its data terms match the OpenAI API's (the free tier may use data).
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Superseded: the review threshold is now an institution setting (Admin -> Institution Settings).
TOPIC_MAPPING_CONFIDENCE_THRESHOLD=0.75
# Secret salt for SHA-256(Student_ID + Salt). Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Never change it after data exists; run `alembic upgrade head` right after setting it the first time.
STUDENT_ID_SALT=
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
